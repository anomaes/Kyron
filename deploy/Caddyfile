{$APP_HOST:workflow.example.internal} {
	encode zstd gzip

	route {
		request_header -X-Token-User-Email
		request_header -X-Token-User-Name
		request_header -X-Token-User-Avatar
		request_header -X-Token-Provider
		request_header -X-Token-Provider-User-Id
		request_header -X-Token-Provider-Username

		handle /api/webhook/gitlab {
			reverse_proxy backend:8000
		}

		handle /api/webhook/github {
			reverse_proxy backend:8000
		}

		handle /api/health {
			reverse_proxy backend:8000
		}

		handle /auth/* {
			reverse_proxy auth-service:3001
		}

		# The VS Code device and token endpoints authenticate with high-entropy
		# one-time or rotating credentials. They must remain reachable before a
		# browser or bearer session exists.
		handle /api/auth/vscode/device {
			reverse_proxy backend:8000
		}

		handle /api/auth/vscode/token {
			reverse_proxy backend:8000
		}

		handle /api/auth/vscode/revoke {
			reverse_proxy backend:8000
		}

		handle /api/* {
			route {
				forward_auth auth-service:3001 {
					uri /auth/verify
					copy_headers {
						X-Token-User-Email
						X-Token-User-Name
						X-Token-User-Avatar
						X-Token-Provider
						X-Token-Provider-User-Id
						X-Token-Provider-Username
					}
				}

				reverse_proxy backend:8000
			}
		}

		handle {
			route {
				forward_auth auth-service:3001 {
					uri /auth/verify
				}

				root * /srv/frontend
				try_files {path} /index.html
				file_server
			}
		}
	}
}
